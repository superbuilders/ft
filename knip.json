{
    "$schema": "https://unpkg.com/knip@latest/schema.json",
    "exclude": ["duplicates"],
    "ignoreExportsUsedInFile": { "interface": true, "type": true },
    "ignoreDependencies": ["@secretlint/.+"],
    "ignoreBinaries": ["dash"],
    "entry": ["src/cli.ts", "scripts/*/index.ts", "*.config.ts", ".oxlint/plugins/**/*.mjs"],
    "project": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "shim/**/*.ts",
        "*.ts",
        ".oxlint/plugins/**/*.mjs"
    ]
}
