#!/bin/sh
SHIM_VERSION=0.2.0

# Releases and .ft/lock.json use the same target names and checksum format.
set -u
umask 077

fail() {
    printf 'ft: %s\n' "$2" >&2
    exit "$1"
}

if [ "${1:-}" = --shim-version ]; then
    printf '%s\n' "$SHIM_VERSION"
    exit 0
fi

stage=
active_pid=
lock=
locked=no
cleanup() {
    if [ -n "$active_pid" ]; then
        kill "$active_pid" 2>/dev/null || :
    fi
    [ -z "$stage" ] || rm -rf "$stage"
    [ "$locked" = no ] || rm -rf "$lock"
    return 0
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

case $(uname -s) in
    Linux) os=linux ;;
    Darwin) os=darwin ;;
    *) fail 2 'unsupported platform (expected Linux or Darwin)' ;;
esac
case $(uname -m) in
    arm64|aarch64) arch=arm64 ;;
    x86_64|amd64) arch=x64 ;;
    *) fail 2 'unsupported platform architecture (expected arm64 or x64)' ;;
esac
target=$os-$arch

# Classify the command once. The machine-wide upgrade and uninstall, and any --user command, use
# the personal pin wherever they run: a repository's pin and config do not apply to them. Commands
# that set a scope up, or work without one, may start the newest runner when nothing is pinned.
personal_only=no
bootstrap_allowed=no
case ${1:-} in
    upgrade|update|uninstall) personal_only=yes bootstrap_allowed=yes ;;
    init|pin) bootstrap_allowed=yes ;;
esac
# An npm install runs its own ft for any command where nothing is pinned, and always for the
# machine-wide commands, which manage the npm install itself rather than a pinned runner.
npm_own=no
if [ -n "${FT_NPM_PACKAGE:-}" ]; then
    bootstrap_allowed=yes
    case ${1:-} in
        upgrade|update|uninstall) npm_own=yes ;;
    esac
fi
for arg; do
    [ "$arg" != --user ] || personal_only=yes
done
personal=${XDG_CONFIG_HOME:-${HOME:+$HOME/.config}}
[ -z "$personal" ] || personal=$personal/ft/.ft.json

project=$(pwd -P) || fail 2 'cannot resolve working directory'
config=
while [ "$personal_only" = no ]; do
    if [ -f "$project/.ft.json" ]; then
        config=$project/.ft.json
        break
    fi
    [ "$project" != / ] || break
    project=${project%/*}
    [ -n "$project" ] || project=/
done
# A directory with no .ft.json of its own uses the personal config, if there is one.
if [ -z "$config" ]; then
    [ -n "$personal" ] || fail 2 'HOME is not set (set it, or set XDG_CONFIG_HOME and XDG_CACHE_HOME)'
    [ ! -f "$personal" ] || config=$personal
fi
scope=
[ -z "$config" ] || [ "$config" != "$personal" ] || scope=' --user'

bootstrap=no
pinned=${config%/*}/.ft/lock.json
if [ -n "$config" ] && [ -f "$pinned" ]; then
    version=$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$pinned")
    expected=$(sed -n '/^[[:space:]]*"sha256"[[:space:]]*:/,/^[[:space:]]*}/p' "$pinned" |
        sed -n "s/^[[:space:]]*\"$target\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p")
    [ -n "$expected" ] || fail 2 "missing hash for target $target in $pinned"
    FT_CONFIG=$config
    export FT_CONFIG
else
    if [ "$bootstrap_allowed" = no ]; then
        [ -z "$config" ] ||
            fail 2 "no $pinned (run ft pin$scope)"
        [ "$personal_only" = no ] ||
            fail 2 'no personal config (set it up with ft init --user)'
        fail 2 'no .ft.json here or above, and no personal config (set ft up with ft init for this repository, or ft init --user for your personal setup)'
    fi
    bootstrap=yes
    unset FT_CONFIG
fi

validate_version() {
    printf '%s\n' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$' ||
        fail 2 'invalid or missing runner version'
}
validate_hash() {
    [ "${#expected}" -eq 64 ] && printf '%s\n' "$expected" | grep -Eq '^[0-9a-fA-F]+$' ||
        fail 2 "invalid SHA-256 for target $target"
    expected=$(printf '%s' "$expected" | tr 'A-F' 'a-f')
}

if { [ "$bootstrap" = yes ] || [ "$npm_own" = yes ]; } && [ -n "${FT_NPM_PACKAGE:-}" ]; then
    command -v bun >/dev/null 2>&1 || fail 2 'bun is required to run ft from npm (see https://bun.sh)'
    exec bun "$FT_NPM_PACKAGE/src/cli.ts" "$@"
fi

# FT_RELEASE_URL points at a mirror or fork with GitHub's release URL layout.
release_url=${FT_RELEASE_URL:-https://github.com/superbuilders/ft/releases}
release_url=${release_url%/}

[ -n "${XDG_CACHE_HOME:-}" ] || [ -n "${HOME:-}" ] ||
    fail 2 'HOME is not set (set it, or set XDG_CACHE_HOME)'
cache=${XDG_CACHE_HOME:-$HOME/.cache}/ft
# A runner is cached under its version and checksum, so a different build of the same version is
# never mistaken for the pinned one.
if [ "$bootstrap" = no ]; then
    validate_version
    validate_hash
    if [ -f "$cache/runner/$version/$expected/ft" ]; then
        exec "$cache/runner/$version/$expected/ft" "$@"
    fi
fi

(umask 077 && mkdir -p "$cache/runner" "$cache/staging" "$cache/locks") || fail 1 'cannot create cache directories'
cache=$(cd "$cache" && pwd -P) || fail 1 'cannot resolve cache directory'

new_stage() {
    stage=$(mktemp -d "$cache/staging/XXXXXXXXXX") || fail 1 'cannot create staging directory'
}
require_curl() {
    command -v curl >/dev/null 2>&1 || fail 2 'curl is required to download ft releases'
}
# Fetch a release URL with curl; the extra arguments say where its output goes.
release_get() {
    url=$release_url/$1
    shift
    # wait is interruptible by traps, unlike a foreground external command.
    curl -fsSL "$@" "$url" 2>"$stage/curl.stderr" &
    active_pid=$!
    if wait "$active_pid"; then
        active_pid=
        return 0
    fi
    active_pid=
    reason=$(sed -n '$s/^curl: ([0-9]*) //p' "$stage/curl.stderr")
    fail 1 "cannot download $url${reason:+ ($reason)}"
}

if [ "$bootstrap" = yes ]; then
    require_curl
    new_stage
    # The latest URL redirects to the newest release's tag page; the tag is its last segment.
    # Not $(release_get ...): a subshell would hide active_pid from cleanup and hold off the TERM trap.
    release_get latest -I -o /dev/null -w '%{url_effective}' >"$stage/tag"
    tag=$(cat "$stage/tag")
    tag=${tag##*/}
    case $tag in
        v*) version=${tag#v} ;;
        *) fail 2 'latest release has an invalid tag' ;;
    esac
    validate_version
    release_get "download/v$version/SHA256SUMS" -o "$stage/SHA256SUMS"
    expected=$(sed -n "s/^\([0-9a-fA-F]*\)  ft-$target\$/\1/p" "$stage/SHA256SUMS")
    [ -n "$expected" ] || fail 2 "missing hash for target $target in release SHA256SUMS"
    validate_hash
    if [ -f "$cache/runner/$version/$expected/ft" ]; then
        cleanup
        stage=
        exec "$cache/runner/$version/$expected/ft" "$@"
    fi
fi
runner=$cache/runner/$version/$expected

lock=$cache/locks/runner-$version.lock
host=$(hostname) || fail 1 'cannot resolve lock hostname'
waiting=no
while ! mkdir "$lock" 2>/dev/null; do
    owner_pid=
    owner_host=
    if [ -f "$lock/owner" ]; then
        read -r owner_pid owner_host <"$lock/owner" || :
    fi
    case $owner_pid in
        ''|*[!0-9]*|0)
            # An owner is written right after the lock is made, so a lock still without one a minute
            # later was left by an install that was killed in between.
            if [ -n "$(find "$lock" -prune -mmin +1 2>/dev/null)" ]; then
                rm -rf "$lock" || fail 1 'cannot recover abandoned runner lock'
                continue
            fi
            ;;
        *)
            if [ "$owner_host" = "$host" ] && ! kill -0 "$owner_pid" 2>/dev/null; then
                rm -rf "$lock" || fail 1 'cannot recover stale runner lock'
                continue
            fi
            ;;
    esac
    if [ "$waiting" = no ]; then
        printf 'ft: waiting for the runner-%s install lock (held by process %s on %s)\n' "$version" "${owner_pid:-unknown}" "${owner_host:-unknown}" >&2
        waiting=yes
    fi
    sleep 0.2
done
locked=yes
printf '%s %s\n' "$$" "$host" >"$lock/owner" || fail 1 'cannot write runner lock owner'

if [ ! -f "$runner/ft" ]; then
    require_curl
    [ -n "$stage" ] || new_stage
    release_get "download/v$version/ft-$target" -o "$stage/ft-$target"
    if command -v sha256sum >/dev/null 2>&1; then
        actual=$(sha256sum <"$stage/ft-$target") || fail 1 'SHA-256 verification failed'
    elif command -v shasum >/dev/null 2>&1; then
        actual=$(shasum -a 256 <"$stage/ft-$target") || fail 1 'SHA-256 verification failed'
    else
        fail 2 'sha256sum or shasum is required'
    fi
    actual=${actual%% *}
    [ "$actual" = "$expected" ] || fail 1 "checksum mismatch for ft-$target"
    chmod +x "$stage/ft-$target" || fail 1 'cannot make runner executable'
    "$stage/ft-$target" --version >"$stage/smoke.stdout" 2>"$stage/smoke.stderr" &
    active_pid=$!
    wait "$active_pid" || fail 1 'runner version check failed (--version)'
    active_pid=
    smoke=$(cat "$stage/smoke.stdout") || fail 1 'cannot read runner version check result'
    [ "$smoke" = "$version" ] || fail 1 'runner version check failed (unexpected version)'
    mv "$stage/ft-$target" "$stage/ft" || fail 1 'cannot prepare runner'
    rm -f "$stage/curl.stderr" "$stage/smoke.stdout" "$stage/smoke.stderr" "$stage/SHA256SUMS" "$stage/tag" || fail 1 'cannot clean staging metadata'
    mkdir -p "$cache/runner/$version" || fail 1 'cannot create cache directories'
    mv "$stage" "$runner" || fail 1 'cannot publish runner'
    stage=
fi
cleanup
stage=
locked=no
exec "$runner/ft" "$@"
