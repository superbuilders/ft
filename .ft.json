{
    "$schema": "./.ft/schema.json",
    "providers": {
        "truefoundry": {
            "key": {
                "env": "TFY_API_KEY"
            },
            "baseUrl": {
                "env": "TFY_BASE_URL"
            },
            "api": "openai-completions",
            "compat": {
                "supportsDeveloperRole": false
            },
            "models": [
                {
                    "id": "claude-opus-5-5",
                    "name": "Opus 5.5",
                    "reasoning": true,
                    "input": ["text"],
                    "contextWindow": 1000000,
                    "maxTokens": 32768,
                    "compat": {
                        "supportsStore": false
                    }
                },
                {
                    "id": "gpt-6.1-sol",
                    "name": "Sol",
                    "reasoning": true,
                    "input": ["text"],
                    "contextWindow": 1050000,
                    "maxTokens": 32768
                },
                {
                    "id": "sonar-pro",
                    "name": "Sonar Pro",
                    "reasoning": false,
                    "input": ["text"],
                    "contextWindow": 200000,
                    "maxTokens": 8192,
                    "adapter": "sonar"
                }
            ]
        }
    },
    "lanes": {
        "code": {
            "model": "truefoundry/gpt-6.1-sol",
            "thinking": "high",
            "description": "Reviews, investigations and scoped changes."
        },
        "research": {
            "model": "truefoundry/sonar-pro",
            "description": "Live web research with sources. Runs without tools."
        }
    }
}
